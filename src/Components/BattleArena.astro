---
const { isVisible = false } = Astro.props;
---

<section
  id="battleArena"
  class={`${isVisible ? "block" : "hidden"} relative mx-auto max-w-6xl px-4 py-6`}
>
  <!-- TÍTULO -->
  <div class="mb-6 text-center">
    <h2
      class="bg-gradient-to-r from-red-500 via-purple-500 to-blue-500 bg-clip-text text-3xl sm:text-4xl font-extrabold tracking-widest text-transparent drop-shadow-lg"
    >
      SUPERHERO BATTLE
    </h2>
    <p class="mt-2 text-base sm:text-lg font-medium text-gray-300">
      ¿Quién saldrá victorioso?
    </p>
  </div>

  <!-- CONTENEDOR DE HÉROES -->
  <div class="flex flex-col gap-12 md:flex-row md:gap-6 items-center justify-center">
    
    <!-- MARVEL -->
    <div
      id="heroMarvelContainer"
      class="group w-full sm:max-w-xs rounded-2xl border-4 border-red-600 bg-gray-900/80 p-6 shadow-xl backdrop-blur-lg transition-transform duration-300 hover:scale-105 hover:shadow-red-500/60"
    >
      <!-- Contenido dinámico de Marvel -->
    </div>

    <!-- VS Y RESULTADO -->
    <div class="flex flex-col items-center gap-4">
      <div
        class="flex h-20 w-20 sm:h-24 sm:w-24 animate-pulse items-center justify-center rounded-full border-4 border-gray-700 bg-gradient-to-br from-gray-900 to-black text-2xl sm:text-4xl font-extrabold text-white shadow-2xl"
      >
        VS
      </div>
      <div
        id="battleResult"
        class="min-h-[1.5rem] text-center text-base sm:text-lg font-semibold tracking-wide text-gray-200 transition-all"
      >
        <!-- Resultado -->
      </div>
    </div>

    <!-- DC -->
    <div
      id="heroDcContainer"
      class="group w-full sm:max-w-xs rounded-2xl border-4 border-blue-600 bg-gray-900/80 p-6 shadow-xl backdrop-blur-lg transition-transform duration-300 hover:scale-105 hover:shadow-blue-500/60"
    >
      <!-- Contenido dinámico de DC -->
    </div>

  </div>

  <!-- BOTÓN NEW BATTLE -->
  <div class="mt-8 text-center">
    <button
      id="newBattle"
      class="relative inline-block rounded-xl bg-gradient-to-r from-blue-600 to-red-600 px-8 sm:px-10 py-3 text-sm sm:text-base font-extrabold tracking-widest text-white transition-transform duration-300 hover:scale-105 hover:shadow-lg hover:shadow-white/30"
    >
      NEW BATTLE
    </button>
  </div>
</section>
